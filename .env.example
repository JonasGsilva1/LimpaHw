# Configurações de Conexão com a OLT Huawei (Acesso Direto)
OLT_HOST=192.168.1.100
OLT_PORT=22
OLT_USERNAME=admin
OLT_PASSWORD=admin_password
OLT_ENABLE_PASSWORD=
OLT_TIMEOUT=30
OLT_DEVICE_TYPE=huawei_smartax

# Configurações do JumpServer / Bastion Host (Opcional - caso use PAM/Bastion)
JUMPSERVER_ENABLED=false
JUMPSERVER_HOST=jump.seuprovedor.com.br
JUMPSERVER_PORT=2222
JUMPSERVER_USER=seu.usuario
JUMPSERVER_PASSWORD=sua.senha
JUMPSERVER_ACCOUNT=auth.olt

# Regras de Limpeza de ONTs
# Quantidade mínima de tempo offline para exclusão
CLEANUP_TIME_VALUE=30
CLEANUP_TIME_UNIT=dias

# Modo de simulação (True = apenas simula; False = executa a deleção real na OLT)
CLEANUP_DRY_RUN=true

# Se deve deletar ONTs que nunca conectaram (Last down time e Last up time vazios)
CLEANUP_DELETE_NEVER_CONNECTED=false

# Palavras-chave na descrição para NUNCA deletar (separadas por vírgula)
CLEANUP_WHITELIST=VIP,DEDICADO,GOVERNO,EMPRESA,TESTE

# Diretórios para backups e logs
CLEANUP_BACKUP_DIR=./backups
CLEANUP_LOG_DIR=./logs
